# Puerto del servidor Nest
PORT=3000

# Postgres (Prisma). Ejemplo local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/errores_softland?schema=public"

# Orígenes permitidos para CORS (coma-separado). El front de Vite corre en 5173.
CORS_ORIGIN="http://localhost:5173"

# Clave que n8n tiene que mandar en el header "x-api-key" al pegarle a /ingesta/errores.
# Si se deja vacío, el endpoint queda abierto (solo para desarrollo).
INGEST_API_KEY=""

# (Opcional) Webhook de n8n que dispara el reproceso (UPDATE SAR_CORMVH ... STATUS='N').
# Si se deja vacío, el reproceso queda solo registrado en la DB y n8n lo levanta
# por GET /errores/reproceso-pendientes.
N8N_REPROCESO_WEBHOOK_URL=""

# (Opcional) Con iFlow Studio: código del primer nodo del flujo de reproceso.
# Si está, la URL de arriba tiene que ser
#   https://api-studio.iflow21.com/api/v1/spOrchestrator/execute
# y se manda { executionKey, parameters: { empresa, modulo, identi }, isFile }.
IFLOW_REPROCESO_EXECUTION_KEY=""

# Token Bearer de un "Usuario API" de iFlow Studio (rol API_EXECUTOR).
# Sin él iFlow responde 403 al ejecutar.
IFLOW_API_TOKEN=""

# (Opcional) Código del nodo 1 del flujo "Enviar resultado a API" de iFlow
# (FSOF-0004, el GET resultado-pendiente). Lo usa el botón "Consultar resultado"
# del detalle; sin él, el botón avisa que falta configurarlo. Usa el mismo
# IFLOW_API_TOKEN: el Usuario API tiene que estar asociado también a este servicio.
IFLOW_RESULTADO_EXECUTION_KEY=""

# Secreto para firmar los JWT de login. OBLIGATORIO en producción (el server no
# arranca sin él si NODE_ENV=production). Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# (Opcional) SSO con Microsoft Entra ID (cuentas de Outlook corporativo).
# Salen del "App registration" de Azure (plataforma Web; ver README, sección SSO).
# Con las cuatro cargadas el login muestra SÓLO "Ingresar con Microsoft" y se
# corta el login con contraseña. Si faltan todas, queda email y contraseña; si
# falta alguna, en producción el backend no arranca (para no reabrir el login).
#   Overview -> "Directory (tenant) ID"
AZURE_TENANT_ID=""
#   Overview -> "Application (client) ID"
AZURE_CLIENT_ID=""
#   Certificates & secrets -> el "Value" del secret (NO el "Secret ID"). Secreto:
#   nunca va al repo ni al front.
AZURE_CLIENT_SECRET=""
#   Tiene que ser idéntica a la Redirect URI cargada en Azure.
#   Prod: https://iris.iflow21.com/api/auth/microsoft/callback
AZURE_REDIRECT_URI="http://localhost:3000/auth/microsoft/callback"
# (Opcional) Dominios de email que pueden entrar, separados por coma. Sin esto,
# sólo @iflow21.com (deja afuera a los invitados de otras empresas del tenant).
AZURE_DOMINIOS_PERMITIDOS="iflow21.com"
# A dónde vuelve la persona tras loguearse. En prod no hace falta (se usa el
# dominio de AZURE_REDIRECT_URI); en local el front corre en otro puerto.
FRONTEND_URL="http://localhost:5173"
