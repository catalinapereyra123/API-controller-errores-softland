# Puerto del servidor Nest
PORT=3000

# Postgres (Prisma). Ejemplo local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/errores_softland?schema=public"

# Orígenes permitidos para CORS (coma-separado). El front de Vite corre en 5173.
CORS_ORIGIN="http://localhost:5173"

# Clave que n8n tiene que mandar en el header "x-api-key" al pegarle a /ingesta/errores.
# Si se deja vacío, el endpoint queda abierto (solo para desarrollo).
INGEST_API_KEY=""

# (Opcional) Webhook de n8n que dispara el reproceso (UPDATE SAR_CORMVH ... STATUS='N').
# Si se deja vacío, el reproceso queda solo registrado en la DB y n8n lo levanta
# por GET /errores/reproceso-pendientes.
N8N_REPROCESO_WEBHOOK_URL=""
